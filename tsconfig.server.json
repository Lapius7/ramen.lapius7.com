{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["bun"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["server", "src/lib/prefectures.ts"]
}
